# Read-only proof verifier. Set values locally; never paste tokens into chat.
# Application configuration is generated separately by scripts/prepare_app.py.
# APP_DATABASE_URL=postgresql+psycopg://property_rescue:<local-password>@127.0.0.1:55432/property_rescue
# APP_DB_PASSWORD=<generated-locally>
MATTERMOST_URL=http://127.0.0.1:8065
MATTERMOST_TOKEN=
# Mattermost usernames, as shown in the channel member list (not display names).
PROOF_HUMAN=
PROOF_COORDINATOR=pr-coordinator
PROOF_WORKER=pr-worker
# Copy the root post ID from its Mattermost permalink.
PROOF_ROOT_ID=
# Generate a fresh UUID for each run; use it in the human's PR_CONNECT message.
PROOF_RUN_ID=

